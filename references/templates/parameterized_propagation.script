%% Parameterized Propagation Template
%% Use --var / -D to override any variable. Omitted variables use defaults below.
%% Defaults: SMA=6600 ECC=0.01 INC=45 RAAN=0 AOP=0 TA=180 DRYMASS=850 EPOCH='01 Jan 2025 12:00:00.000' DURATION=3
%% Example (override SMA, INC, DURATION): -D SMA=7200 -D INC=60 -D DURATION=7

Create Spacecraft Sat;
Sat.DateFormat = UTCGregorian;
Sat.Epoch = '{{EPOCH}}';
Sat.CoordinateSystem = EarthMJ2000Eq;
Sat.DisplayStateType = Keplerian;
Sat.SMA = {{SMA}};
Sat.ECC = {{ECC}};
Sat.INC = {{INC}};
Sat.RAAN = {{RAAN}};
Sat.AOP = {{AOP}};
Sat.TA = {{TA}};
Sat.DryMass = {{DRYMASS}};

Create ForceModel FM;
FM.CentralBody = Earth;

Create Propagator Prop;
Prop.FM = FM;
Prop.Type = PrinceDormand78;
Prop.InitialStepSize = 60;
Prop.Accuracy = 1.0e-11;

Create ReportFile RF;
RF.Filename = 'output_report.txt';
RF.Precision = 16;
RF.ColumnWidth = 23;
RF.Add = {Sat.EarthMJ2000Eq.X, Sat.EarthMJ2000Eq.Y, Sat.EarthMJ2000Eq.Z, ...
          Sat.EarthMJ2000Eq.VX, Sat.EarthMJ2000Eq.VY, Sat.EarthMJ2000Eq.VZ};

BeginMissionSequence;
Propagate Prop(Sat) {Sat.ElapsedDays = {{DURATION}}};